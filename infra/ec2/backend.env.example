# Example only. Replace placeholders in /etc/frisco/backend.env on EC2.
# Keep the real file owned by root with permissions 600; never commit it.
DB_URL='jdbc:postgresql://YOUR_RDS_HOSTNAME:5432/frisco?sslmode=require'
DB_USERNAME='frisco_app'
DB_PASSWORD='YOUR_APPLICATION_PASSWORD'
SPRING_JPA_SHOW_SQL='false'

# Compose overrides this host-service setting with 0.0.0.0 inside the container.
SERVER_ADDRESS='127.0.0.1'
