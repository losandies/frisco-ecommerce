{
    "name": "frisco-clothing-dept",
    "version": "1.0.0",
    "description": "Full-stack streetwear storefront with React, Redux, Express, and PostgreSQL",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "server": "node server.js",
        "dev": "node scripts/dev.js",
        "build": "npm run build --prefix client",
        "setup": "npm ci && npm ci --prefix client && npm run db:generate",
        "db:generate": "node scripts/prisma.js generate",
        "db:push": "node scripts/prisma.js db push",
        "db:seed": "node prisma/seed.js",
        "test": "node --test tests/*.test.js",
        "test:integration": "node --test tests/*.integration.js",
        "db:migrate": "node scripts/prisma.js migrate deploy",
        "test:browser": "playwright test"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "prisma": "^4.11.0"
    },
    "dependencies": {
        "@prisma/client": "^4.11.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3"
    },
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    }
}
